# Template de documentação e validação local/CI.
# Para produção, execute helpers/install.py: ele gera o .env com credenciais novas.
# Não use os valores de exemplo abaixo em ambientes reais.

# Armazenamento persistente no manager Swarm.
DATALAKE_STORAGE_PATH=/opt/arenalake-data
DATALAKE_QUOTA_GB=100

# Credenciais somente ilustrativas; substitua por valores fortes e únicos.
DBA_USERNAME=arenalake_example_admin
DBA_PASSWORD=replace_with_a_unique_password_123
DATABASE_URL=postgresql://arenalake_example_admin:replace_with_a_unique_password_123@postgres:5432/arenalake_core
MINIO_ACCESS_KEY=arenalake_example_minio
MINIO_SECRET_KEY=replace_with_another_unique_secret_123
JWT_SECRET_KEY=replace_with_a_random_64_character_hexadecimal_secret

# Rede e imagens do Swarm.
WORKSPACE_NETWORK=arenalake-net
WORKSPACE_IMAGE=ghcr.io/l1k3d/arenalake-infra/workspace:latest
PORTAL_IMAGE=ghcr.io/l1k3d/arenalake-infra/portal:latest
TELEMETRY_IMAGE=ghcr.io/l1k3d/arenalake-infra/telemetry:latest

# Endpoints e portas publicados no host.
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_UI_PORT=8080
SPARK_RPC_PORT=7077
TRAEFIK_DASH_PORT=8089
PORTAL_PORT=8088
TRAEFIK_WEB_PORT=80

# Valores consumidos pelo instalador; algumas opções ainda não são usadas pelo Compose.
SPARK_MASTER_URL=spark://spark-master:7077
TAILSCALE_BASE_URL=
AUTO_UPDATE_WORKSPACE=false
AUTO_UPDATE_CORE=false
